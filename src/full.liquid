{%- assign tom_date = daily.time[1] -%}
{%- assign wd = tom_date | date: "%w" | plus: 0 -%}
{%- assign sv_days = "söndag,måndag,tisdag,onsdag,torsdag,fredag,lördag" | split: "," -%}
<div class="layout layout--col layout--top gap--small lg:gap--xlarge">
  <div class="grid grid--cols-2 gap--large w--full portrait:grid--cols-1 portrait:gap--small">
    <div class="flex flex--row flex--center-y gap--medium">
      <div class="w--32 h--32 lg:w--48 lg:h--48 shrink-0" data-wmo="{{ cur.weather_code }}" data-day="{{ cur.is_day }}"></div>
      <div class="flex flex--col flex--left gap--xsmall">
        <span class="title">Nu</span>
        <span class="value value--xlarge lg:value--xxlarge value--tnums">{{ cur.temperature_2m | round }}°</span>
        <span class="title" data-wmo-text="{{ cur.weather_code }}"></span>
        <span class="description description--large">Känns som {{ cur.apparent_temperature | round }}°</span>
      </div>
    </div>
    <div class="flex flex--row flex--center-y gap--medium">
      <div class="w--32 h--32 lg:w--40 lg:h--40 shrink-0" data-wmo="{{ daily.weather_code[1] }}" data-day="1"></div>
      <div class="flex flex--col flex--left gap--xsmall">
        <span class="title">I morgon {{ sv_days[wd] }}</span>
        <span class="value value--xlarge lg:value--xxlarge value--tnums">{{ daily.temperature_2m_max[1] | round }}° <span class="value value--small">/ {{ daily.temperature_2m_min[1] | round }}°</span></span>
        <span class="title" data-wmo-text="{{ daily.weather_code[1] }}"></span>
      </div>
    </div>
  </div>
  <div class="grid grid--cols-2 gap--large w--full portrait:grid--cols-1 portrait:gap--small">
    <div class="grid grid--cols-2 gap--small">
      <div class="item"><div class="content">
        <span class="label">Vind</span>
        <span class="title title--large lg:title--xlarge"><span data-wind-dir="{{ cur.wind_direction_10m }}"></span> {{ cur.wind_speed_10m | round }} m/s</span>
        <span class="description description--large">byar {{ cur.wind_gusts_10m | round }} m/s</span>
      </div></div>
      <div class="item"><div class="content">
        <span class="label">Nederbörd 12 h</span>
        <span class="title title--large lg:title--xlarge">{{ rain12 | round: 1 }} mm</span>
        <span class="description description--large">{% if snow12 > 0 %}varav snö {{ snow12 | round: 1 }} cm{% elsif rain12 == 0 %}uppehåll{% else %}regn{% endif %}</span>
      </div></div>
    </div>
    <div class="grid grid--cols-2 gap--small">
      <div class="item"><div class="content">
        <span class="label">Vind i morgon</span>
        <span class="title title--large lg:title--xlarge"><span data-wind-dir="{{ daily.wind_direction_10m_dominant[1] }}"></span> {{ daily.wind_speed_10m_max[1] | round }} m/s</span>
        <span class="description description--large">byar {{ daily.wind_gusts_10m_max[1] | round }} m/s</span>
      </div></div>
      <div class="item"><div class="content">
        <span class="label">{% if daily.snowfall_sum[1] > 0 %}Snö i morgon{% else %}Regn i morgon{% endif %}</span>
        <span class="title title--large lg:title--xlarge">{% if daily.snowfall_sum[1] > 0 %}{{ daily.snowfall_sum[1] | round: 1 }} cm{% else %}{{ daily.precipitation_sum[1] | round: 1 }} mm{% endif %}</span>
        <span class="description description--large">risk {{ daily.precipitation_probability_max[1] }} %</span>
      </div></div>
    </div>
  </div>
  <div class="divider"></div>
  <div class="grid grid--cols-8 gap--small w--full portrait:grid--cols-4">
    {%- for k in (1..8) -%}
      {%- assign i = k | times: 3 | plus: h0 -%}
      {%- if hourly.time[i] -%}
      <div class="flex flex--col flex--center-x{% if k > 4 %} portrait:hidden{% endif %}">
        <span class="label">{{ hourly.time[i] | slice: 11, 2 }}</span>
        <div class="w--10 h--10 lg:w--16 lg:h--16" data-wmo="{{ hourly.weather_code[i] }}" data-day="{{ hourly.is_day[i] }}"></div>
        <span class="title title--large lg:title--xlarge">{{ hourly.temperature_2m[i] | round }}°</span>
        <span class="description description--large">{% if hourly.precipitation[i] > 0 %}{{ hourly.precipitation[i] | round: 1 }} mm{% else %}&nbsp;{% endif %}</span>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
<div class="title_bar">
  <span class="title">Väder</span>
  <span class="instance">{% if cf.place != blank %}{{ cf.place }} · {% endif %}uppdaterat {{ cur.time | slice: 11, 5 }}</span>
</div>
